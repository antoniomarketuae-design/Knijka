node_modules/
.next/
# Alternate build dirs. next.config.ts reads KNIJKA_DIST_DIR so the clip rig —
# and any agent that needs a server of its own — can build somewhere the shared
# :3000 server will not fight over. Each one is GIGABYTES: three parallel agents
# left 12.3 GB across .next-overflow / .next-hud-ux / .next-answers-above-fold,
# which showed up as 621 untracked files one `git add -A` away from being
# committed. The default stays plain `.next`, so this ignores only the opt-ins.
.next-*/
dist/
build/
.env
.env.local
.env*.local
*.log
.DS_Store
.vercel
coverage/
*.tsbuildinfo
.mcp.json

# clip rig server state (pid + log) — tools/clips/headless/clip-rig.mjs
tools/clips/headless/.rig/
tools/clips/headless/.r0look/

# R0 review frames — captured to LOOK at (doc 66: look before you ship), then
# thrown away. They are evidence for one review, not product: the pipeline's
# real outputs are the .webm + WebP keyframes under platform/public/clips/.
# NOTE: tools/clips/headless/sheets/ IS tracked — those contact sheets are
# referenced from the docs, so the rule below deliberately does not reach them.
tools/clips/headless/*.png
tools/clips/headless/r0*/
tools/clips/headless/cluster/

# R0 review captures at repo root. Same rule as tools/clips/headless/r0*/ — these
# are frames captured to LOOK at (doc 66) for ONE review, then thrown away. A
# phone-reclaim run left 37 MB of them here and `git add -A` swept them in.
.r0phone/
.sim-shots/
