# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# why-panel clip pilot: the .webm binaries stay out of git — they deploy by
# scp to the VPS public dir (see public/clips/README.md). Only the manifest
# contract + the README are tracked.
/public/clips/*
!/public/clips/manifest.json
!/public/clips/README.md

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
!.env.example
src/generated/
