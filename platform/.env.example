# Copy to .env — never commit .env
# Local dev: `npx prisma dev` (local Prisma Postgres) or any Postgres instance
DATABASE_URL="postgresql://user:password@localhost:5432/aidriver"

# Claude API (tutor/debrief layer — ADR-002)
ANTHROPIC_API_KEY=""
# Hard daily ceiling on what the tutor may spend on that key, in US dollars
# (audit H-8). Optional — the default in src/modules/tutor/budget.ts applies
# when unset, and an unparseable value falls back to it rather than to zero.
# Past the ceiling the tutor answers in Bulgarian that it is out for the day;
# it never errors, and practice + explanations keep working.
# Sized for ~3,500 answers/day. Do NOT raise it further without checking that
# the per-pack allowance (payments/quota.ts) is still in force — this ceiling
# is a site-wide brownout switch, not a per-user brake (doc 81 §5.2-5.3).
TUTOR_DAILY_BUDGET_USD="40"

# Auth secret (generate: openssl rand -base64 32)
AUTH_SECRET=""

# --- Payments (Stripe, one-time packs — src/modules/payments) ---
# Without STRIPE_SECRET_KEY the app still runs: /pricing shows the packs with
# disabled "Скоро" buttons and the webhook answers 503. No crashes.
STRIPE_SECRET_KEY=""
# Publishable key — client-side, required for the embedded /checkout page
# (renders card + Apple Pay + Revolut Pay). pk_test_… / pk_live_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret of the /api/stripe/webhook endpoint (whsec_..., from the
# Stripe dashboard → Developers → Webhooks, or `stripe listen` in dev)
STRIPE_WEBHOOK_SECRET=""
# Absolute base URL of this deployment — used for Stripe success/cancel
# redirects AND for the password-reset link in the e-mail below. A wrong value
# here means every reset link 404s, so set it per environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Transactional e-mail (src/modules/mail) ---
# Today the product needs exactly one e-mail: the password-reset link (audit
# H-14). The flow is COMPLETE and tested without any of the variables below —
# with MAIL_TRANSPORT unset it uses the console transport and prints the reset
# link into the server log (`npm run dev` locally, `pm2 logs knijka` on the
# VPS), so a locked-out student can be recovered today by reading it out.
#
# TO TURN ON REAL DELIVERY — this is the only remaining step, no code change:
#   1. Open an account at https://resend.com or https://postmarkapp.com
#      (both have a free tier that covers a Bulgarian launch; either works).
#   2. Verify the sending domain there (SPF + DKIM DNS records) — an unverified
#      sender is what puts account-recovery mail in the spam folder.
#   3. Set the three variables below and restart the app. That is all.
#
# console (default) | resend | postmark. A provider name with missing
# credentials falls back to console with a warning — never a crash, because a
# mail misconfiguration must not also break the recovery page.
MAIL_TRANSPORT="console"
# Provider API key: Resend `re_...` / Postmark server token. Required by both
# providers; ignored by the console transport.
MAIL_API_KEY=""
# Sender, on the domain verified in step 2. Display name is shown to students.
# Required for a provider (they reject an unverified/absent From).
MAIL_FROM="Книжка.AI <no-reply@example.bg>"
# Optional: where a student's reply goes. Leave empty to send no Reply-To.
MAIL_REPLY_TO=""

# --- Tutor voice (pre-rendered TTS — tools/theory/synthesize_bg.mjs, doc 81 §3.3) ---
# BUILD-TIME ONLY. Nothing in the app calls a TTS API at runtime, by design:
# the bytes a student hears are a fixed rendering of approved, lawRefs-cited
# content, so no model can free-recall Bulgarian law into a student's ears
# (ADR-002). Leaving every value below empty is the correct state today — the
# script then runs its dry-run transport and spends nothing.
#
# TWO independent brakes, both required before a single paid call is made:
# credentials here AND `--allow-spend` on the command line. `--plan` prints the
# bill first (today: 5,962 files, 646,083 chars, $9.69 at the westeurope meter).
#
# DO NOT ARM THIS before the §3.4 voice audition — no bg-BG voice has yet been
# heard by a native ear, and shipping captions-only is an acceptable outcome.
# azure | dryrun. Anything else falls back to dryrun with a printed reason.
TUTOR_TTS_PROVIDER="azure"
TUTOR_TTS_VOICE="bg-BG-KalinaNeural"
# Azure portal → Speech resource. The region matters: the $15/1M price above was
# read from westeurope's sheet, and another region is another price sheet.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="westeurope"
