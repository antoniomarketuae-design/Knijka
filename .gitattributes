# Line-ending policy for the BYTE-EXACT gates.
#
# WHY THIS FILE EXISTS (2026-08-11). Six trace fixtures failed the determinism
# gate with a diff nobody could see. The recordings were correct to the last
# digit; the files ended `0d 0a` instead of `0a`. Git for Windows ships
#
#     core.autocrlf = true
#
# in its SYSTEM config (C:/Program Files/Git/etc/gitconfig), so a checkout
# rewrites the trailing LF of every "text" file to CRLF. Git then normalises
# CRLF away again when it compares, so `git diff` and `git status` show
# NOTHING — while the gates below read raw bytes off disk and fail. A red gate
# with an empty diff is unreadable by construction, and this is one way the
# shared baseline drifted between runs without anyone changing content.
#
# The rules are inert with respect to content: every one of these files is
# already stored LF in the index (verified, 1209/1209). They only stop git from
# corrupting the working copy on the next checkout / stash pop / reset.
#
# If you add a new gate that compares a file's bytes to a generated string,
# add its glob here.

# Recorded ghost drives — platform/src/modules/sim/traces/__tests__/*, each
# asserting `readFileSync(contentFile) === serializeScenarioTrace(...) + "\n"`,
# plus the content/ ↔ platform/public/ byte-parity assertion.
*.trace.json                    text eol=lf

# Generated modules gated byte-for-byte against their regenerated render
# (clips/clipPlan.generated.ts, clips/whyPanelMap.generated.ts).
*.generated.ts                  text eol=lf

# District files: the published copy must be byte-identical to the content
# source (sim/lessons/scenario/__tests__/templates.test.ts).
content/world/*.json            text eol=lf
platform/public/world/*.json    text eol=lf
